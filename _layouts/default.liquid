<!doctype html>
<html lang="{{ site.lang | escape }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% unless page.url == '/' %}{{ page.title | escape }} | {% endunless %}{{ site.data.profile.display_name | escape }}</title>
    <meta name="description" content="{{ site.description | escape }}">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link rel="icon" href="{{ '/assets/img/icon.png' | relative_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/site.css' | relative_url }}">
  </head>
  <body class="page-{{ page.title | slugify }}">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="site-nav" aria-label="Main navigation">
        <a class="site-name" href="{{ '/' | relative_url }}">{{ site.data.profile.display_name | escape }}</a>
        <ul class="nav-links">
          {% for item in site.navigation %}
          <li><a href="{{ item.url | relative_url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title | escape }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <div class="page-heading">
        <h1>{% if page.url == '/' %}{{ site.data.profile.display_name | escape }}{% elsif page.url == '/cv/' %}Curriculum vitae{% else %}{{ page.title | escape }}{% endif %}</h1>
        {% if page.url == '/cv/' %}<a class="button button-primary" href="{{ site.data.profile.cv_pdf | relative_url }}">Download CV <span aria-hidden="true">↓</span> <span>(PDF)</span></a>{% endif %}
      </div>
      {{ content }}
    </main>
    <footer class="site-footer">© {{ site.time | date: '%Y' }} {{ site.data.profile.display_name | escape }}.</footer>
  </body>
</html>
